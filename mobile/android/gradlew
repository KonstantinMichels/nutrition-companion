#!/bin/sh

# Gradle start-up script generated for the checked-in wrapper.
APP_PATH="$0"
while [ -h "$APP_PATH" ]; do
  LINK_TARGET=$(readlink "$APP_PATH")
  case "$LINK_TARGET" in
    /*) APP_PATH="$LINK_TARGET" ;;
    *) APP_PATH=$(dirname "$APP_PATH")/"$LINK_TARGET" ;;
  esac
done
APP_HOME=$(cd "$(dirname "$APP_PATH")" && pwd -P)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
  JAVACMD=$JAVA_HOME/bin/java
else
  JAVACMD=java
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
  echo "JAVA_HOME is not set and no java command could be found." >&2
  exit 1
fi

DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -Dorg.gradle.appname=gradlew \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
